# SPDX-License-Identifier: MIT
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(UNIX AND NOT APPLE)
  find_dependency(OpenSSL COMPONENTS Crypto)
endif()

if("@ORPHEUS_SNDFILE_PROVIDER_RESOLVED@" STREQUAL "SndFile")
  find_dependency(SndFile CONFIG)
  if(NOT TARGET SndFile::sndfile)
    message(FATAL_ERROR "OrpheusSDK requires SndFile::sndfile")
  endif()
elseif("@ORPHEUS_SNDFILE_PROVIDER_RESOLVED@" STREQUAL "PkgConfig")
  find_dependency(PkgConfig)
  pkg_check_modules(SNDFILE REQUIRED IMPORTED_TARGET sndfile)
  if(NOT TARGET PkgConfig::SNDFILE)
    message(FATAL_ERROR "OrpheusSDK requires PkgConfig::SNDFILE")
  endif()
endif()

if(CMAKE_CONFIGURATION_TYPES)
  # A multi-config install contains the configuration selected by
  # `cmake --install --config`. Map the other Visual Studio configurations to
  # that same installed artifact so CMake does not reject missing locations.
  set(_orpheus_sdk_imported_config "${CMAKE_BUILD_TYPE}")
  if(NOT _orpheus_sdk_imported_config)
    set(_orpheus_sdk_imported_config Release)
  endif()
  foreach(_orpheus_sdk_config DEBUG RELEASE RELWITHDEBINFO MINSIZEREL)
    set(CMAKE_MAP_IMPORTED_CONFIG_${_orpheus_sdk_config}
        "${_orpheus_sdk_imported_config}")
  endforeach()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/OrpheusSDKTargets.cmake")

set(OrpheusSDK_VERSION "@PROJECT_VERSION@")
set(OrpheusSDK_C_ABI_MAJOR "@ORPHEUS_ABI_MAJOR@")
set(OrpheusSDK_C_ABI_MINOR "@ORPHEUS_ABI_MINOR@")

function(_orpheus_sdk_alias stable_name exported_name)
  if(TARGET "${exported_name}" AND NOT TARGET "${stable_name}")
    add_library("${stable_name}" INTERFACE IMPORTED)
    set_property(TARGET "${stable_name}" PROPERTY INTERFACE_LINK_LIBRARIES "${exported_name}")
  endif()
endfunction()

set(OrpheusSDK_INCLUDE_DIR "${PACKAGE_PREFIX_DIR}/include")
_orpheus_sdk_alias(Orpheus::core Orpheus::orpheus_core)
_orpheus_sdk_alias(Orpheus::diagnostics Orpheus::orpheus_diagnostics)
_orpheus_sdk_alias(Orpheus::audio_utils Orpheus::orpheus_audio_utils)
_orpheus_sdk_alias(Orpheus::audio_io Orpheus::orpheus_audio_io)
_orpheus_sdk_alias(Orpheus::audio_driver_manager Orpheus::orpheus_audio_driver_manager)
_orpheus_sdk_alias(Orpheus::routing Orpheus::orpheus_routing)
_orpheus_sdk_alias(Orpheus::transport Orpheus::orpheus_transport)
_orpheus_sdk_alias(Orpheus::audio_driver_coreaudio Orpheus::orpheus_audio_driver_coreaudio)
_orpheus_sdk_alias(Orpheus::audio_driver_wasapi Orpheus::orpheus_audio_driver_wasapi)
_orpheus_sdk_alias(Orpheus::shmui_juce Orpheus::orpheus_shmui_juce)
_orpheus_sdk_alias(Orpheus::shmui_juce_gl Orpheus::orpheus_shmui_juce_gl)

check_required_components(OrpheusSDK)

