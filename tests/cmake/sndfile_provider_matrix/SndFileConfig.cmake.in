get_filename_component(_fake_sndfile_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
if(NOT TARGET SndFile::sndfile)
  add_library(SndFile::sndfile STATIC IMPORTED)
  set_target_properties(SndFile::sndfile PROPERTIES
    IMPORTED_LOCATION "${_fake_sndfile_prefix}/lib/@CMAKE_STATIC_LIBRARY_PREFIX@fake_sndfile@CMAKE_STATIC_LIBRARY_SUFFIX@"
    INTERFACE_INCLUDE_DIRECTORIES "${_fake_sndfile_prefix}/include")
endif()
set(SndFile_FOUND TRUE)
